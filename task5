    console.log("Department:", dept);
    console.log("------------------");
  }
}

// 5. Create a callback function to generate payroll reports.

function payrollReport(emp) {

  let  nameKey = Object.keys(emp).find(key => key.startsWith("name"));
  let  deptKey = Object.keys(emp).find(key => key.startsWith("department"));

  let  name = emp[nameKey];
  let  dept = emp[deptKey];

  let deptDesc;

  switch (dept) {
    case "IT":
      deptDesc = "Information Technology";
      break;
    case "HR":
      deptDesc = "Human Resources";
      break;
    case "Finance":
      deptDesc = "Finance Department";
      break;
    case "Marketing":
      deptDesc = "Marketing Department";
      break;
    default:
      deptDesc = "Unknown Department";
  }

  console.log(`${name} | ₹${emp.salary} | ${deptDesc}`);
}

// higher-order function
function generatePayroll(employees, callback) {
  for (let emp of employees) {
    callback(emp);
  }
}

// call function
generatePayroll(employees, payrollReport);


