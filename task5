//4.Use switch statement for department descriptions.

for (let emp of employees) {

  let dept = Object.values(emp).find(
    value => value === "IT" || value === "HR" || value === "Finance" || value === "Marketing"
  );
  let name = Object.values(emp).find(value => typeof value === "string" && value !== dept);

if (emp.salary > 30000) {

    switch (dept) {
      case "IT":
        dept = "IT Department";
        break;
      case "HR":
        dept = "HR Department";
        break;
