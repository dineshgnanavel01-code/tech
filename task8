// Task 1: Employee Salary Management

let employees = [
  { id: 1, name: "Rahul", salary: 25000 },
  { id: 2, name: "Kavin", salary: 50000 },
  { id: 3, name: "John", salary: 75000 }
];

// 1 Find employees whose salary is above ₹40,000
let highEarners = employees.filter(emp => emp.salary > 40000);
console.log("Employees with salary > 40,000:", highEarners);

// 2 Find the first employee whose salary is above ₹60,000
let firstHighEarner = employees.find(emp => emp.salary > 60000);
console.log("First employee with salary > 60,000:", firstHighEarner);

// 3 Calculate total company salary expense
let totalSalary = employees.reduce((acc, emp) => acc + emp.salary, 0);
