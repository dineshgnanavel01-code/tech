let inventoryA = [
  { id: 1, name: "Laptop", quantity: 10, price: 50000 },
  { id: 2, name: "Mouse", quantity: 50, price: 500 }
];

let inventoryB = [
  { id: 3, name: "Keyboard", quantity: 30, price: 1500 },
