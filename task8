// Task 7: Bank Account System

let balance = 0;

function deposit(amount) {
    balance += amount;
    return balance;
}

function withdraw(amount) {
    if (amount > balance) {
        return "Insufficient Balance";
    }
    balance -= amount;
    return balance;
}

function checkBalance() {
    return balance;
}

console.log("Deposit 1000: ", deposit(1000));  
console.log("Withdraw 500: ", withdraw(500));  
console.log("Withdraw 700: ", withdraw(700));  
console.log("Check Balance: ", checkBalance());


// Task 8: Movie Ticket Booking

let bookedSeats = [];

// Function to book a seat
function bookSeat(seatNumber) {
    if (bookedSeats.includes(seatNumber)) {
        console.log("Seat " + seatNumber + " is already booked.");
    } else {
        bookedSeats.push(seatNumber);
        console.log("Seat " + seatNumber + " booked successfully.");
    }
    return bookedSeats;
}

// Function to check seat availability
function checkSeat(seatNumber) {
    if (bookedSeats.includes(seatNumber)) {
        return "Seat " + seatNumber + " is NOT available.";
    } else {
        return "Seat " + seatNumber + " is available.";
    }
}

// Function to print all booked seats
function printBookedSeats() {
    console.log("Booked Seats:");
    for (let i = 0; i < bookedSeats.length; i++) {
        console.log("Seat " + bookedSeats[i]);
    }
}


bookSeat(1);
bookSeat(2);
bookSeat(5);
console.log(checkSeat(2));  
console.log(checkSeat(3));  
printBookedSeats();         



// Task 9: User Login Validation

function validateUser(username, password, email) {
  // Check username: should not contain spaces
  if (username.includes(" ")) {
    return "Invalid: Username should not contain spaces.";
  }

  // Check password: minimum 8 characters
  if (password.length < 8) {
    return "Invalid: Password must be at least 8 characters.";
  }

  // Check email: must contain "@"
  if (!email.includes("@")) {
    return "Invalid: Email must contain '@'.";
  }

  return "All inputs are valid!";
}


