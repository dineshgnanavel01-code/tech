// Member 1: API Integration
function fetchProducts() {
  fetch("https://fakestoreapi.com/products")
    .then(response => response.json())
    .then(data => {
      console.log(" Products fetched:", data);
      
    })
    .catch(error => {
      console.error(" Error fetching products:", error);
    });
}