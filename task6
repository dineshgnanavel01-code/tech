//Task 14: Railway Reservation System


let totalSeats = 50;


//Book seats using function.

function bookSeats(requestSeats) {
  if (requestSeats <= totalSeats) {
    totalSeats -= requestSeats;
    console.log(requestSeats + " seat(s) booked successfully");
  } else {
    console.log("Booking Failed: Not enough seats available");
  }
}
