// 7  Arithmetic Operators
let shirt = 500;
let pant = 1000;
let shoe = 1500;

let totalCost = shirt + pant + shoe;
let discount = totalCost > 2000 ? totalCost * 0.10 : 0;
let finalCost = totalCost - discount;

//printting the results
console.log("Total Cost :", totalCost);
console.log("Discount :", discount);
console.log("Final Cost :", finalCost);


// 8 Comparison Operator
let age = 19;

//printting the results
if (age >= 18) {
    console.log("Eligible for Voting");
} else {
    console.log("Not Eligible");
}


//9 Pre/Post Increment
let a = 10;

//printting the results
a++;
console.log("After a++ :", a);

++a;
console.log("After ++a :", a);

a--;
console.log("After a-- :", a);

--a;
console.log("After --a :", a);


// 10 Boolean, Logical Operators
let isPresent = true;
let completedTask = true;
//printting the results

if (isPresent && completedTask) {
    console.log("Eligible for Salary");
} else {
    console.log("Not Eligible");
}

//Bonus Company-Level Task

let student = {
    id:101,
    name:"Dinesh",
    department:"Development",
    salary:35000,
    experience:2
};

let Share  = student.salary * 0.10;
let EndSalary = student.salary + Share ;

let performanceStatus =
    student.experience >= 2 ? "Good" : "Average";

console.log("Student ID :", student.id);
console.log("Student Name :", student.name);
console.log("Department :", student.department);
console.log("Salary :", student.salary);
console.log("Experience :", student.experience, "Years");

console.log("\nShare :", Share );
console.log("End Salary :", EndSalary);

console.log("\nPerformance Status :", performanceStatus);
