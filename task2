//1  Variables, Comparison, Logical, Ternary
let marks = 75;

let result = marks >= 35 ? "Pass" : "Fail";

let grade =
    marks >= 90 ? "Grade A" :
    marks >= 75 ? "Grade B" :
    marks >= 60 ? "Grade C" :
    "Fail";

console.log("Result :", result);
console.log("Grade :", grade);

// 2. Arithmetic, Assignment Operators
let salary = 25000;
let bonus = salary * 0.10;
let finalSalary = salary + bonus;

//printting the results

console.log("Original Salary :", salary);
console.log("Bonus :", bonus);
console.log("Final Salary :", finalSalary);

// 3 logical operators
let email = "admin@gmail.com";
let password = "12345";

console.log(
    email === "admin@gmail.com" && password === "12345"
    ? "Login Success"
    : "Login Failed"
);
//4 Arithmetic, Ternary
let price = 2000;
let finalAmount = price > 1000 ? price - (price * 0.20) : price;

//printting the results
console.log("Final Amount :", finalAmount);


// 5 Array
let products = ["Laptop","Mobile","Mouse","Keyboard"];

//printting the results
console.log("First Product :", products[0]);
console.log("Last Product :", products[products.length - 1]);
console.log("Total Products Count :", products.length);

