// 10 Task 10: Mini Employee Management System (Real Company Task)


let employees = [
    { id: 1, name: "Dinesh", salary: 25000 },
    { id: 2, name: "Surya", salary: 30000 },
    { id: 3, name: "Karthik", salary: 40000 }
];

// Initial values
let totalEmployees = employees.length;
let totalSalary = 0;

let highest = employees[0];
let lowest = employees[0];

// Print all employees + calculations
for (let i = 0; i < employees.length; i++) {
    console.log(employees[i]);

    totalSalary += employees[i].salary;

    if (employees[i].salary > highest.salary) {
        highest = employees[i];
    }

    if (employees[i].salary < lowest.salary) {
        lowest = employees[i];
    }
}



console.log("Highest Salary Employee: ", highest);
console.log("Lowest Salary Employee: ", lowest);
console.log("Total Employees: " + totalEmployees);
console.log("Total Salary Expenditure: " + totalSalary);
