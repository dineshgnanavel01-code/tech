// 1 Salary Calculation Program

// Basic Salary
basic_salary = 25000

// HRA = 20% of salary
hra = 0.20 * basic_salary

// Bonus = 10% of salary
bonus = 0.10 * basic_salary

//  Total salary before tax
total_salary = basic_salary + hra + bonus

// Tax = 5% of total salary
tax = 0.05 * total_salary

//  Final salary after tax
final_salary = total_salary - tax

//  Print final salary
console.log("Final Salary after tax:", final_salary)

